{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.9.0",
	"FriendlyName": "Anomaly Injector",
	"Description": "Injects labeled visual anomalies into UE5 games to generate synthetic training data for bug-detection ML. Game-agnostic via public UE APIs.",
	"Category": "Anomaly Injection",
	"CreatedBy": "GDP Anomaly Injection Project",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"EnabledByDefault": true,
	"Modules": [
		{
			"Name": "AnomalyBench",
			"Type": "Runtime",
			"TargetAllowList": [ "Editor", "Game" ],
			"TargetConfigurationDenyList": [ "Shipping" ],
			"LoadingPhase": "Default"
		},
		{
			"Name": "AnomalyShaders",
			"Type": "Runtime",
			"TargetConfigurationDenyList": [ "Shipping" ],
			"LoadingPhase": "PostConfigInit"
		},
		{
			"Name": "AnomalyInjector",
			"Type": "Runtime",
			"TargetConfigurationDenyList": [ "Shipping" ],
			"LoadingPhase": "Default"
		},
		{
			"Name": "AnomalyCapture",
			"Type": "Runtime",
			"TargetConfigurationDenyList": [ "Shipping" ],
			"LoadingPhase": "Default"
		},
		{
			"Name": "AnomalyControlServer",
			"Type": "Runtime",
			"TargetConfigurationDenyList": [ "Shipping" ],
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "WebSocketNetworking",
			"Enabled": true
		}
	]
}
