# UE build/derived artifacts — never versioned.
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# Compiler/debugger leftovers
*.pdb
*.obj
*.o

# Build-time TICKPIN force-override markers — operator-local, must never travel.
ANOMINJECT_TICKPIN_FORCE_ON
ANOMINJECT_TICKPIN_FORCE_OFF

# Python bytecode from tools/ - the verifier imports measure_label_offset.py, which creates it.
__pycache__/
*.pyc

# IDE
.vs/
*.sln
*.suo
*.user
*.vcxproj*
.vscode/
