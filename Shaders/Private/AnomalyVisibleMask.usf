// AnomalyVisibleMask.usf — occlusion-correct silhouette mask (m26 slice 1).
// For each pixel: if the custom-stencil value is one of our reserved tags AND the tagged surface is
// the front-most one there (custom depth not behind the scene's front surface, reversed-Z), output
// the tag; else 0. The CPU then reduces to a per-tag SURVIVING-PIXEL COUNT. Bound: the scene-texture
// uniform buffer (FSceneTextureShaderParameters) provides CustomStencilTexture / CustomDepthTexture /
// SceneDepthTexture.
//
// Mined READ-ONLY from feature/stencil-capture (76cac74). That branch is NOT checked out, merged or
// rebased; this file is a copy, and the branch's foliage blacklist and USkeletalMeshComponent
// narrowing deliberately did NOT come with it.

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"

float DepthBias;
uint ReservedBase;
int2 ViewRectMin;
int2 InternalRectMin;
int2 InternalRectSize;
int2 OutputRectSize;

void MainPS(float4 SvPosition : SV_POSITION, out uint OutMask : SV_Target0)
{
	// The mask RT is the OUTPUT view-rect size (0-based) because this pass runs after tonemap, but the
	// scene textures are at INTERNAL (pre-upscale) resolution. Map output -> internal explicitly and
	// clamp inside the internal rect, so no sample can land on pooled content left by an earlier frame
	// outside it. At 100% screen percentage this is the identity mapping.
	int2 Scaled = (int2(SvPosition.xy) * InternalRectSize + OutputRectSize / 2) / OutputRectSize;
	int2 P = InternalRectMin + clamp(Scaled, int2(0, 0), InternalRectSize - int2(1, 1));

	uint Stencil = CalcSceneCustomStencil((uint2)P);
	if (Stencil < ReservedBase)
	{
		OutMask = 0;
		return;
	}

	float CustomDeviceZ = SceneTexturesStruct.CustomDepthTexture.Load(int3(P, 0)).r;
	float SceneDeviceZ  = SceneTexturesStruct.SceneDepthTexture.Load(int3(P, 0)).r;

	// Reversed-Z: nearer = larger device Z. The tagged surface is visible (front-most) iff it is at
	// least as near as the scene's front-most surface, within a small device-Z bias.
	OutMask = (CustomDeviceZ >= SceneDeviceZ - DepthBias) ? Stencil : 0;
}
