// AnomalyMaskReduce.usf — m34 GPU reduction of the m26 visible mask.
// Reduces the R8_UINT AnomalyVisibleMask render target to a 256-entry
// {Count, MinX, MinY, MaxX, MaxY, DrawnCount} R32_UINT table (tag-major, stride 6 -> 1,536 uints =
// 6,144 B). INTEGER ATOMICS ONLY, so the result is BIT-EXACT equal to the render-thread CPU scan it
// replaces, order-independent. Mins are stored BIT-INVERTED so all four bounds use InterlockedMax
// against the zero-cleared buffer; the CPU decodes with ~ and gates every bounds read on Count > 0
// (skip value 0).
// Groupshared per-group histogram + bounds first, then ONE global atomic merge per group per present
// tag — keeps worst case flat under heavy tag coverage.
//
// m49 phase B: index 5 is DrawnCount, reduced from a SECOND render target in the SAME dispatch. The
// stride moved 5 -> 6 and indices 0..4 DID NOT MOVE, so every existing decode reads the same slot.
// DrawnTexture is a strict subset of MaskTexture by construction (|CustomZ - SceneZ| <= bias implies
// CustomZ >= SceneZ - bias), so DrawnCount <= Count always.

#include "/Engine/Private/Common.ush"

Texture2D<uint> MaskTexture;
Texture2D<uint> DrawnTexture;
RWBuffer<uint> OutTable;
int2 MaskSize;

groupshared uint GroupTable[1536];

[numthreads(8, 8, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	for (uint Init = GroupIndex; Init < 1536; Init += 64)
	{
		GroupTable[Init] = 0;
	}
	GroupMemoryBarrierWithGroupSync();

	const int2 P = int2(GroupId.xy) * 8 + int2(GroupThreadId.xy);
	if (P.x < MaskSize.x && P.y < MaskSize.y)
	{
		const uint V = MaskTexture.Load(int3(P, 0));
		if (V != 0)
		{
			const uint Base = V * 6;
			InterlockedAdd(GroupTable[Base + 0], 1u);
			InterlockedMax(GroupTable[Base + 1], ~((uint)P.x));
			InterlockedMax(GroupTable[Base + 2], ~((uint)P.y));
			InterlockedMax(GroupTable[Base + 3], (uint)P.x);
			InterlockedMax(GroupTable[Base + 4], (uint)P.y);
		}

		const uint D = DrawnTexture.Load(int3(P, 0));
		if (D != 0)
		{
			InterlockedAdd(GroupTable[D * 6 + 5], 1u);
		}
	}
	GroupMemoryBarrierWithGroupSync();

	for (uint Tag = GroupIndex; Tag < 256; Tag += 64)
	{
		const uint Base = Tag * 6;
		const uint GroupCount = GroupTable[Base + 0];
		if (GroupCount != 0)
		{
			InterlockedAdd(OutTable[Base + 0], GroupCount);
			InterlockedMax(OutTable[Base + 1], GroupTable[Base + 1]);
			InterlockedMax(OutTable[Base + 2], GroupTable[Base + 2]);
			InterlockedMax(OutTable[Base + 3], GroupTable[Base + 3]);
			InterlockedMax(OutTable[Base + 4], GroupTable[Base + 4]);
		}
		const uint GroupDrawn = GroupTable[Base + 5];
		if (GroupDrawn != 0)
		{
			InterlockedAdd(OutTable[Base + 5], GroupDrawn);
		}
	}
}
