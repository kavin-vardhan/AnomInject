#include "/Engine/Private/Common.ush"

Texture2D<float4> PhysicalTexture;
Texture2D<uint4> PageTable;
RWBuffer<uint> OutStats;
int2 SourceSize;
int2 PageOrigin;
uint TileSize;
uint BorderSize;
uint CoordinateBits;

groupshared uint GroupStats[9];

[numthreads(8, 8, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
    if (GroupIndex < 9)
    {
        GroupStats[GroupIndex] = 0;
    }
    GroupMemoryBarrierWithGroupSync();
    const int2 P = int2(GroupId.xy) * 8 + int2(GroupThreadId.xy);
    if (P.x < SourceSize.x && P.y < SourceSize.y)
    {
        const uint Entry = PageTable.Load(int3(PageOrigin + P / TileSize, 0)).x;
        if ((Entry >> 4) != 0 && (Entry & 15) == 0)
        {
            const uint Mask = (1u << CoordinateBits) - 1u;
            const uint2 Tile = uint2((Entry >> 4) & Mask, (Entry >> (4 + CoordinateBits)) & Mask);
            const uint2 Physical = Tile * (TileSize + 2 * BorderSize) + BorderSize + uint2(P) % TileSize;
            const uint4 Q = uint4(round(saturate(PhysicalTexture.Load(int3(Physical, 0))) * 65535.0));
            InterlockedMax(GroupStats[0], ~Q.x);
            InterlockedMax(GroupStats[1], ~Q.y);
            InterlockedMax(GroupStats[2], ~Q.z);
            InterlockedMax(GroupStats[3], ~Q.w);
            InterlockedMax(GroupStats[4], Q.x);
            InterlockedMax(GroupStats[5], Q.y);
            InterlockedMax(GroupStats[6], Q.z);
            InterlockedMax(GroupStats[7], Q.w);
            InterlockedAdd(GroupStats[8], 1u);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (GroupIndex < 8)
    {
        InterlockedMax(OutStats[GroupIndex], GroupStats[GroupIndex]);
    }
    else if (GroupIndex == 8)
    {
        InterlockedAdd(OutStats[8], GroupStats[8]);
    }
}
